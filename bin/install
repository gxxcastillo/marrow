#!/usr/bin/env bash
# Bootstraps marrow on a machine with no local checkout: clones the tool repo to a fixed
# location (~/.local/share/marrow), then runs that checkout's own bin/setup. Safe to
# re-run — it updates the existing managed checkout in place rather than re-cloning.
# If you already have this repo checked out, run bin/setup directly instead.
set -euo pipefail

repo_url="https://github.com/gxxcastillo/marrow.git"
default_branch="main"
clone_dir="$HOME/.local/share/marrow"

if ! command -v git >/dev/null 2>&1; then
  echo "install: git is required but not found on PATH" >&2
  exit 1
fi
if [ "$#" -ne 0 ]; then
  echo "install: unexpected arguments; run 'marrow init --from <vault-url>' after install to attach an existing vault" >&2
  exit 2
fi

if [ -e "$clone_dir" ]; then
  if [ -d "$clone_dir/.git" ] && \
     [ "$(git -C "$clone_dir" remote get-url origin 2>/dev/null)" = "$repo_url" ]; then
    if [ -n "$(git -C "$clone_dir" status --porcelain 2>/dev/null)" ]; then
      echo "install: refusing to update $clone_dir — it has local changes (inspect with 'git -C $clone_dir status', or remove the directory to reinstall cleanly)" >&2
      exit 1
    fi
    echo "install: updating existing checkout at $clone_dir"
    git -C "$clone_dir" fetch --depth 1 origin "$default_branch"
    git -C "$clone_dir" reset --hard "origin/$default_branch"
  else
    echo "install: refusing to overwrite existing $clone_dir (not a checkout managed by this script)" >&2
    exit 1
  fi
else
  echo "install: cloning $repo_url to $clone_dir"
  mkdir -p "$(dirname "$clone_dir")"
  # Sparse-checkout skips test/: it's dev-only, not needed to run marrow.
  git clone --depth 1 --branch "$default_branch" --no-checkout "$repo_url" "$clone_dir"
  git -C "$clone_dir" sparse-checkout set --no-cone '/*' '!/test/'
  git -C "$clone_dir" checkout "$default_branch"
fi

exec "$clone_dir/bin/setup"
