#!/usr/bin/env bash
# One-time local setup: symlink bin/marrow onto PATH, then run `marrow init` to
# create the local vault's bare repo. Safe to re-run — both steps are no-ops if
# already done. Never creates or touches the vault's GitHub remote; use
# `marrow init --from` or `marrow publish` for explicit remote lifecycle work.
set -euo pipefail

if ! command -v git >/dev/null 2>&1; then
  echo "install: git is required but not found on PATH" >&2
  exit 1
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "install: bun is required (to run marrow) but not found on PATH" >&2
  exit 1
fi
# `git worktree add --orphan`, which every `marrow add` depends on, landed in
# git 2.42. `marrow init` does not use it, so without this check install would
# report success and the first `marrow add` would fail on an unknown option.
# Keep the floor in step with MIN_GIT_MAJOR/MIN_GIT_MINOR in src/git.ts.
git_major="$(git --version | sed -n 's/^git version \([0-9][0-9]*\)\..*/\1/p')"
git_minor="$(git --version | sed -n 's/^git version [0-9][0-9]*\.\([0-9][0-9]*\).*/\1/p')"
if [ -z "$git_major" ] || [ -z "$git_minor" ]; then
  echo "install: warning: could not parse '$(git --version)'; marrow needs git 2.42+ for 'git worktree add --orphan'" >&2
elif [ "$git_major" -lt 2 ] || { [ "$git_major" -eq 2 ] && [ "$git_minor" -lt 42 ]; }; then
  echo "install: git 2.42+ is required (found $git_major.$git_minor); 'git worktree add --orphan' is unavailable below it" >&2
  exit 1
fi
if [ "$#" -ne 0 ]; then
  echo "install: unexpected arguments; run 'marrow init --from <vault-url>' after install to attach an existing vault" >&2
  exit 2
fi

# Resolve the directory this script lives in (the tool checkout), following symlinks.
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" != /* ]] && script_path="$script_dir/$script_path"
done
tool_root="$(cd -P "$(dirname "$script_path")/.." && pwd)"

bin_dir="$HOME/.local/bin"

# 1. Symlink bin/marrow onto PATH.
source="$tool_root/bin/marrow"
target="$bin_dir/marrow"
mkdir -p "$bin_dir"

if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
  echo "install: already linked: $target -> $source"
elif [ -e "$target" ]; then
  echo "install: refusing to overwrite existing $target (not a marrow symlink to this checkout)" >&2
  exit 1
else
  ln -s "$source" "$target"
  echo "install: linked $target -> $source"
fi

case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) echo "install: warning: $bin_dir is not on your PATH" >&2 ;;
esac

# 2. Initialize the vault. Invoked directly (not via $target) so this doesn't
# depend on $bin_dir already being on PATH in the current shell.
echo "install: running 'marrow init'..."
"$source" init

echo "install: done. Use 'marrow init --from' or 'marrow publish' for the separate, gated remote step."
