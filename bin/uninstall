#!/usr/bin/env bash
# Reverses install: removes the managed tool checkout (~/.local/share/marrow) and its
# ~/.local/bin/marrow symlink, but only when they still point at a checkout this script
# recognizes as its own. Never touches the vault (MARROW_HOME, default ~/.marrow) — that
# holds real project data; remove it by hand if you actually want it gone.
set -euo pipefail

repo_url="https://github.com/gxxcastillo/marrow.git"
clone_dir="$HOME/.local/share/marrow"
link="$HOME/.local/bin/marrow"

removed_something=0

# bin/setup resolves symlinks in its own location (`cd -P`) before writing
# $link's target, so if any ancestor of $clone_dir (e.g. $HOME itself, under
# a dotfile manager) is a symlink, the target it wrote is the resolved path,
# not this literal one. Compare against both so uninstall still recognizes
# (and cleans up) a symlink it created.
resolved_clone_dir="$clone_dir"
if [ -d "$clone_dir" ]; then
  resolved_clone_dir="$(cd -P "$clone_dir" && pwd)"
fi

if [ -L "$link" ] && { [ "$(readlink "$link")" = "$clone_dir/bin/marrow" ] || [ "$(readlink "$link")" = "$resolved_clone_dir/bin/marrow" ]; }; then
  rm "$link"
  echo "uninstall: removed $link"
  removed_something=1
elif [ -e "$link" ] || [ -L "$link" ]; then
  echo "uninstall: leaving $link alone (does not point at a checkout managed by install)" >&2
fi

if [ -d "$clone_dir/.git" ] && \
   [ "$(git -C "$clone_dir" remote get-url origin 2>/dev/null)" = "$repo_url" ]; then
  rm -rf "$clone_dir"
  echo "uninstall: removed $clone_dir"
  removed_something=1
elif [ -e "$clone_dir" ]; then
  echo "uninstall: leaving $clone_dir alone (not a checkout managed by install)" >&2
fi

if [ "$removed_something" -eq 0 ]; then
  echo "uninstall: nothing to remove — marrow was not installed via install"
fi

vault_home="${MARROW_HOME:-$HOME/.marrow}"
vault_repo="$vault_home/vault.git"
if [ -d "$vault_repo" ]; then
  attached=""
  if attached="$(git -C "$vault_repo" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { path = substr($0, 10) }
    /^branch refs\/heads\// { print substr($0, 19) "\t" path }
  ')" && [ -n "$attached" ]; then
    echo "uninstall: projects are still attached; reinstall marrow and detach each one if you want ordinary files:"
    while IFS=$'\t' read -r branch worktree; do
      echo "  marrow detach '$branch'  # $worktree"
    done <<< "$attached"
  fi
fi

if [ -e "$vault_home" ]; then
  echo "uninstall: vault left in place at $vault_home (holds your project data) — remove it yourself with 'rm -rf $vault_home' if you really want it gone"
fi
